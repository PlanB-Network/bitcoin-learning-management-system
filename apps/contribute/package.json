    "@tanstack/router-devtools": "^1.131.7",
    "@tanstack/router-plugin": "^1.131.7",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-syntax-highlighter": "~15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "ol": "^10.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
