{
  "name": "@blms/contribute",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "vite build --mode production",
    "dev": "vite serve --mode development",
    "lint": "biome check .",
    "type-check": "tsc --build",
    "check-types": "tsc --noEmit --project tsconfig.app.json",
    "trace-performance": "npx tsc --extendedDiagnostics --noEmit -p tsconfig.app.json | head -n 12 > performance.log",
    "clear": "rm -rf ./dist && rm -f *.tsbuildinfo"
  },
  "dependencies": {
    "@blms/constants": "workspace:*",
    "@blms/shared": "workspace:*",
