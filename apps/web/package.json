    "@stripe/stripe-js": "^7.3.1",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.121.2",
    "@trpc/client": "^11.4.0",
    "@trpc/server": "^11.4.0",
    "@trpc/tanstack-react-query": "^11.4.0",
    "class-variance-authority": "^0.7.1",
    "cropperjs": "^1.6.2",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
