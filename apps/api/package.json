    "@blms/service-user": "workspace:*",
    "@blms/shared": "workspace:*",
    "@trpc/server": "^11.9.0",
    "adm-zip": "^0.5.16",
    "argon2": "^0.44.0",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "formidable": "^3.5.4",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lru-cache": "^11.2.5",
    "sharp": "^0.34.5",
    "stripe": "^19.3.1",
    "superjson": "^2.2.6",
    "typesense": "~2.1.0",
    "zod": "~4.1.13"
  },
  "devDependencies": {
    "@blms/types": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
