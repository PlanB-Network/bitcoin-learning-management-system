{
  "$schema": "https://biomejs.dev/schemas/2.3.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/out",
      "!**/dist",
      "!**/node_modules",
      "!**/routeTree.gen.ts",
      "!**/.turbo",
      "!**/.tanstack",
      "!**/packages/database/drizzle/migrations/**/*",
      "!**/packages/types/src/generated/**/*",
      "!**/node_modules",
      "!**/apps/**/node_modules",
      "!**/packages/**/node_modules",
      "!**/packages/ui/storybook-static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
      //   "lineWidth": 80
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noStaticElementInteractions": "off" // To remove
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "correctness": {
        "noNestedComponentDefinitions": "off", // To check
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "info",
        "useUniqueElementIds": "off" // To remove
      },
      "recommended": true,
      "style": {
        "noInferrableTypes": "error",
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "off",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noDuplicateProperties": "off", //To remove
        "noExplicitAny": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noUnknownAtRules": "off" // To remove,
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": false
  }
}
