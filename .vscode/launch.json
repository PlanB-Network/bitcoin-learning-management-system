{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to API (Local)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["pnpm", "run", "dev"],
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8181",
      "webRoot": "${workspaceFolder}/apps/web/src"
    }
  ]
}
