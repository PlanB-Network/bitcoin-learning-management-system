{
  "configurations": [
    {
      "cwd": "${workspaceFolder}",
      "localRoot": "${workspaceFolder}",
      "name": "Run all (Local)",
      "request": "launch",
      "restart": true,
      "runtimeArgs": ["pnpm", "run", "dev"],
      "runtimeExecutable": "pnpm",
      "type": "node"
    },
    {
      "name": "Debug Web (Chrome)",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8181",
      "webRoot": "${workspaceFolder}/apps/web/src"
    }
  ],
  "version": "0.2.0"
}
