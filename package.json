{
  "name": "blms",
  "version": "0.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.67.0",
    "lint-staged": "^16.2.6",
    "mocha": "^11.7.4",
    "tsx": "^4.20.6",
    "turbo": "^2.6.3",
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=warn"
    ]
  },
  "packageManager": "pnpm@10.26.0",
  "private": true,
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo",
    "build-types": "turbo run build-types",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:academy": "turbo run build --filter='@blms/academy'",
    "check-boundaries": "turbo boundaries",
    "check-types": "turbo run check-types",
    "clear": "turbo run clear",
    "clear:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "clear:turbo": "find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "clear:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "dev": "turbo dev watch-types --cache-dir=.turbo --parallel",
    "dev:api": "turbo dev watch-types --cache-dir=.turbo --filter=@blms/api --filter=./packages/* --parallel",
    "dev:db:generate": "cd ./packages/database && pnpm drizzle:generate",
    "dev:db:migrate": "cd ./packages/database && pnpm db:migrate",
    "dev:db:migrate:local": "cd ./packages/database && pnpm db:migrate:local",
    "dev:db:studio": "cd ./packages/database && npx drizzle-kit studio",
    "dev:db:sync": "pnpm dev:db:generate && pnpm dev:types:generate",
    "dev:db:populate-slides:local": "cd ./packages/database && pnpm db:populate-slides:local",
    "dev:storybook": "cd ./packages/ui && pnpm storybook",
    "dev:types:generate": "cd ./packages/types && pnpm types:generate",
    "dev:academy": "turbo dev --cache-dir=.turbo --filter=@blms/academy",
    "docker:build-base": "docker build -f docker/Dockerfile.base -t blms-base .",
    "docker:dev": "docker compose pull && docker compose up -d --remove-orphans postgres && docker compose up -d --build --renew-anon-volumes api academy cdn && docker compose exec -u 0:0 api sh -c 'echo $CDN_PATH'",
    "format": "biome format --write .",
    "generate-types": "turbo run generate-types",
    "knip": "knip",
    "lint": "biome check . --diagnostic-level=warn",
    "lint-all": "biome check .",
    "lint:fix": "biome check . --write --diagnostic-level=warn",
    "nuke": "pnpm clear && rm -r .turbo && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm install && pnpm build:packages",
    "pear:testnet": "pnpm pear:build && pnpm pear:run",
    "pear:build": "cd apps/academy && pnpm run pear:build",
    "pear:run": "cd apps/academy && pnpm run pear:run",
    "pear:stage": "cd apps/academy && pnpm run pear:stage",
    "pear:release": "cd apps/academy && pnpm run pear:release",
    "pear:seed": "cd apps/academy && pnpm run pear:seed",
    "prepare": "[ -z \"$CI\" ] && husky || echo 'Skipping husky in CI'",
    "test": "turbo run test",
    "trace-performance": "turbo run trace-performance",
    "type-check": "turbo run type-check"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
