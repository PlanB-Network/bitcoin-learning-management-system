<mjml>
  <mj-head>
    <mj-font name="Rubik" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500&display=swap" />
    <mj-font name="IBM Plex Sans" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'IBM Plex Sans', Rubik, Arial, sans-serif" color="#000000" />
      <mj-text font-size="16px" line-height="24px" letter-spacing="0.10px" />
    </mj-attributes>
    <mj-style>
      .main-title div {
        font-size: 32px !important;
        font-weight: 300 !important;
        line-height: 38.40px !important;
        font-family: 'IBM Plex Sans', Rubik, Arial, sans-serif !important;
      }
      .sub-title div {
        font-size: 18px !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        line-height: 27px !important;
        letter-spacing: 0.10px !important;
        font-family: 'IBM Plex Sans', Rubik, Arial, sans-serif !important;
      }
      .footer-text div {
        letter-spacing: 0.10px !important;
        font-family: Rubik, Arial, sans-serif !important;
      }
      a {
        color: #000000;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-wrapper padding-left="25px" padding-right="25px">
      <!-- Logo -->
      <mj-section padding-top="40px" padding-bottom="20px">
        <mj-column>
          <mj-image src="http://cdn.mcauto-images-production.sendgrid.net/1320c1d7e5304d1f/4fc3540f-18ed-4e56-acc9-11251f854028/558x104.png" alt="Logo" width="264px" align="center" padding="0" />
        </mj-column>
      </mj-section>

      <!-- Main Title -->
      <mj-section padding-top="0px" padding-bottom="16px">
        <mj-column>
          <mj-text align="center" padding-bottom="10px" css-class="main-title">
            User withdrawn
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Main Content -->
      <mj-section padding-top="10px" padding-bottom="0px">
        <mj-column width="90%">
          <mj-text align="center" padding-bottom="20px">
            Hello,<br />The user {{username}} has withdrawn from the school!
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Contact Info & Signature -->
      <mj-section padding-top="0px" padding-bottom="15px">
        <mj-column width="90%">
          <mj-text align="left" padding-bottom="10px">
            If you encounter any issue, please reach out at <a href="mailto:contact@planb.network">contact@planb.network</a>.
          </mj-text>
          <mj-text align="left">
            See you in class!<br /> The Plan ₿ Biz School 2025 team<br /> Plan ₿ Academy
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section padding-top="20px" padding-bottom="40px">
        <mj-column width="100%">
          <mj-text align="center" font-size="12px" line-height="14px" css-class="footer-text">
            You are receiving this email because you have an account on planb.academy.<br />If you would like to change your email preferences, please click <a href="{{unsubscribeLink}}">here</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
