<mjml>
  <mj-head>
    <mj-font name="Rubik" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500&display=swap" />
    <mj-font name="IBM Plex Sans" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'IBM Plex Sans', Rubik, Arial, sans-serif" color="#000000" />
      <mj-text font-size="16px" line-height="24px" letter-spacing="0.10px" font-weight="400" />
      <mj-button border-radius="16px" background-color="#FF5C00" color="#ffffff" font-weight="500" font-size="20px" font-family="Rubik, Arial, sans-serif" inner-padding="14px 18px" />
      <mj-wrapper padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>

    <mj-style>
      .main-title div {
        font-size: 32px !important;
        font-weight: 300 !important;
        line-height: 38.40px !important;
        font-family: 'IBM Plex Sans', Rubik, Arial, sans-serif !important;
      }
      .sub-title div {
        font-size: 18px !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        line-height: 27px !important;
        letter-spacing: 0.10px !important;
        font-family: 'IBM Plex Sans', Rubik, Arial, sans-serif !important;
      }
      .footer-text div {
        letter-spacing: 0.10px !important;
        font-family: Rubik, Arial, sans-serif !important;
      }
      a {
        color: #000000;
        text-decoration: underline;
      }
    </mj-style>

  </mj-head>
  <mj-body>

    <!-- Logo -->
    <mj-section padding-top="40px" padding-bottom="20px">
      <mj-column>
        <mj-image src="http://cdn.mcauto-images-production.sendgrid.net/1320c1d7e5304d1f/60c4ab01-f068-4c89-8535-0a83955e19fa/528x98.png" alt="Plan B Network Logo" width="264px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section padding-top="0px" padding-bottom="16px">
      <mj-column>
        <mj-text align="center" padding-bottom="16px" css-class="main-title">
          {{courseName}}
        </mj-text>
        <mj-text align="center" padding="0" css-class="sub-title">
          class starts in 5 minutes
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main -->
    <mj-section padding-top="10px" padding-bottom="0">
      <mj-column width="90%">
        <mj-text align="center" padding="0" padding-bottom="20px">
          Hello,<br/>This is a quick reminder that your class is starting in 5 minutes!
        </mj-text>
        <mj-button href="{{joinClassLink}}" align="center" padding-bottom="50px">
          Join class now
        </mj-button>
        <mj-text align="center" padding="0" padding-bottom="20px">
          In case the button is not working, you can copy/paste the following URL in your browser : {{joinClassLink}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Contact & signature -->
    <mj-section padding-top="0" padding-bottom="15px">
        <mj-column width="90%">
        <mj-text padding="0" padding-bottom="10px">
          If you encounter any issue, please reach out at <a href="mailto:contact@planb.network" style="color: #000000; text-decoration: underline;">contact@planb.network</a>.
        </mj-text>
        <mj-text padding="0" >
          See you in class!<br />
          The Plan ₿ Biz School 2025 team<br/>
          Plan ₿ Network
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding-top="20px" padding-bottom="40px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="14px" font-weight="400" css-class="footer-text" padding="0 25px">
          You are receiving this email because you have an account on planb.network.<br />If you would like to change your email preferences, please click <a href="{{unsubscribeLink}}" style="color: #000000; text-decoration: underline;">here</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
