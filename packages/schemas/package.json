{
  "dependencies": {
    "@blms/constants": "workspace:*",
    "@blms/database": "workspace:*",
    "drizzle-orm": "^0.44.3",
    "drizzle-zod": "~0.7.1",
    "zod": "^3.25.76"
  },
  "exports": {
    "development": "./src/index.ts",
    "import": "./dist/src/index.js",
    "types": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "name": "@blms/schemas",
  "private": true,
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.json",
