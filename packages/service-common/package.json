{
  "name": "@blms/service-common",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/src/index.js",
      "types": "./src/index.ts"
    },
    "./*": {
      "development": "./src/*.ts",
      "import": "./dist/src/*.js",
      "types": "./src/*.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "postbuild": "cp -r src/fonts dist/src/fonts/",
    "lint": "biome check .",
    "test": "mocha src/**/*.test.ts",
    "test:bun": "bun test",
    "test:bun:coverage": "bun test --coverage",
    "type-check": "tsc --build",
    "check-types": "tsc --noEmit",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "trace-performance": "npx tsc --extendedDiagnostics --noEmit -p tsconfig.json | head -n 12 > performance.log",
    "clear": "rm -rf ./dist && rm -f *.tsbuildinfo"
  },
  "dependencies": {
    "pdfjs-dist": "^5.3.31"
  },
  "devDependencies": {
    "@blms/types": "workspace:*"
  }
}
