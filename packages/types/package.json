{
  "devDependencies": {
    "@blms/constants": "workspace:*",
    "@blms/schemas": "workspace:*",
    "@types/express-session": "^1.18.2",
    "typescript": "~5.9.3",
    "typesense": "~2.1.0",
    "zod": "~4.1.12"
  },
  "exports": {
    "development": "./src/index.ts",
    "import": "./dist/src/index.js",
    "types": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "name": "@blms/types",
  "scripts": {
    "build": "tsc --build tsconfig.json && pnpm lint:fix",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "clear": "rm -rf ./dist && rm -f *.tsbuildinfo",
    "generate-types": "tsx ./scripts/generate-from-schemas.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ./src/generated",
    "trace-performance": "npx tsc --extendedDiagnostics --noEmit -p tsconfig.json | head -n 12 > performance.log",
    "type-check": "tsc --build",
    "types:generate": "tsx ./scripts/generate-from-schemas.ts",
    "types:generate:bun": "bun run ./scripts/generate-from-schemas.ts && bun lint:fix",
    "watch-types": "tsc --emitDeclarationOnly -p tsconfig.json --watch --preserveWatchOutput"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "0.0.1",
  "dependencies": {
    "@duplojs/zod-to-typescript": "^0.4.2",
    "json-schema-to-typescript": "^15.0.4"
  }
}
