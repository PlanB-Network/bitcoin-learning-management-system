{
  "root": false,
  "extends": "//",
  "assist": {
    "actions": { "source": { "organizeImports": "on", "useSortedKeys": "off" } }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 80
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "info"
      },
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}
