{
  "dependencies": {
    "@blms/constants": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "pg": "^8.16.3"
  },
  "exports": {
    "development": "./src/index.ts",
    "import": "./dist/src/index.js",
    "types": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "name": "@blms/database",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clear": "rm -rf ./dist && rm -f *.tsbuildinfo",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:migrate:local": "tsx --env-file=../../.env ./scripts/migrate.ts",
    "drizzle:check": "drizzle-kit check --config=drizzle.config.ts",
    "drizzle:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "drizzle:introspect": "drizzle-kit introspect --config=drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:up": "drizzle-kit up --config=drizzle.config.ts",
    "lint": "biome check .",
    "trace-performance": "npx tsc --extendedDiagnostics --noEmit -p tsconfig.json | head -n 12 > performance.log",
    "type-check": "tsc --build",
    "db:populate-slides": "tsx ./scripts/populate-slides.ts",
    "db:populate-slides:local": "node --env-file=../../.env -- tsx ./scripts/populate-slides.ts",
    "watch-types": "tsc --emitDeclarationOnly -p tsconfig.json --watch --preserveWatchOutput"
  },
  "type": "module",
  "types": "./src/index.ts",
  "version": "0.0.1"
}
