{
  "name": "@blms/ui",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc --build tsconfig.json",
    "lint": "biome check .",
    "type-check": "tsc --build",
    "check-types": "tsc --noEmit",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.json",
